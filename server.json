{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.flipletters/mcp",
  "title": "FlipLetters",
  "description": "Draft, validate, render, and share split-flap and flip-dot board videos written in flipcode.",
  "version": "0.3.1",
  "websiteUrl": "https://flipletters.com/mcp",
  "repository": {
    "url": "https://github.com/Terahertz-Inc/flipletters-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.flipletters.com/mcp/v1",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token: your flk_ API key from FlipLetters Studio > Account > API keys & agents",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "flipletters-mcp-server",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FLIPLETTERS_API_KEY",
          "description": "Your flk_ API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
