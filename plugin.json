  "author": {
    "name": "Terahertz, Inc.",
    "email": "support@flipletters.com",
    "url": "https://flipletters.com"
  },
  "homepage": "https://flipletters.com",
  "repository": "https://github.com/Terahertz-Inc/flipletters-mcp",
  "license": "MIT",
  "keywords": [
    "flipletters",
    "flipcode",
    "split-flap",
    "flip-dot",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "flipletters": {
